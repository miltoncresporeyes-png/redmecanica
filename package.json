{
  "name": "redmecanica-root",
  "private": true,
  "workspaces": [
    "shared",
    "backend",
    "frontend"
  ],
  "scripts": {
    "build": "npm run build -w shared && npm run build -w frontend",
    "build:api": "npm run build -w shared && npm run prisma:generate -w backend && npm run build -w backend",
    "build:frontend": "npm run build -w shared && npm run build -w frontend",
    "build:backend": "npm run build -w shared && npm run prisma:generate -w backend && npm run build -w backend",
    "install:all": "npm install",
    "start": "npm start -w backend",
    "start:backend": "npm start -w backend"
  },
  "overrides": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "ip-address": "^10.3.1",
    "socket.io-parser": "^4.2.7",
    "brace-expansion": "^5.0.9"
  },
  "optionalDependencies": {
    "@rollup/rollup-darwin-arm64": "4.59.0",
    "@rollup/rollup-darwin-x64": "4.59.0",
    "@rollup/rollup-linux-arm-gnueabihf": "4.59.0",
    "@rollup/rollup-linux-arm-musleabihf": "4.59.0",
    "@rollup/rollup-linux-arm64-gnu": "4.59.0",
    "@rollup/rollup-linux-arm64-musl": "4.59.0",
    "@rollup/rollup-linux-x64-gnu": "4.59.0",
    "@rollup/rollup-linux-x64-musl": "4.59.0",
    "@rollup/rollup-win32-arm64-msvc": "4.59.0",
    "@rollup/rollup-win32-x64-gnu": "4.59.0",
    "@rollup/rollup-win32-x64-msvc": "4.59.0"
  },
  "dependencies": {
    "resend": "^6.20.0"
  }
}
