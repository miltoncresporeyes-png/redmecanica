<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # La API vive en Railway. Este hosting es estatico, asi que /api se reenvia al backend (requiere mod_proxy).
  RewriteRule ^api/(.*)$ https://backend-production-f294e.up.railway.app/api/$1 [P,L]

  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
