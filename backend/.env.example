# Server
PORT=3011
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@host:5432/redmecanica?schema=public"

# JWT Secrets (generate strong random strings for production)
ACCESS_TOKEN_SECRET="your_access_token_secret_min_32_chars"
REFRESH_TOKEN_SECRET="your_refresh_token_secret_min_32_chars"

# Frontend URL (for CORS)
FRONTEND_URL="http://localhost:5173"

# Gemini AI (optional, for AI features)
GEMINI_API_KEY=""

# Webpay Plus (Transbank)
# Obtener credenciales en https://www.transbankdevelopers.cl/
# Modo integración (pruebas): usar códigos de prueba de Transbank
WEBPAY_COMMERCE_CODE=""
WEBPAY_API_KEY=""
WEBPAY_RETURN_URL="https://tu-dominio.com/payment/return"
WEBPAY_FINAL_URL="https://tu-dominio.com/payment/final"

# Email (SMTP) – mandatory in production. Provide a real SMTP account
# (Gmail, Sendgrid, etc). If these are empty the server will now fail with an
# explicit error instead of pretending it sent messages.
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT=465
SMTP_USER="your-email@example.com"
SMTP_PASS="TU_PASSWORD_SMTP"
SMTP_FROM="RedMecánica <contacto@redmecanica.cl>"

# Maps (Mapbox o Google Maps)
# Mapbox: https://account.mapbox.com/
# Google Maps: https://console.cloud.google.com/
MAPS_PROVIDER="mapbox"  # Options: "mapbox" or "google"
MAPS_API_KEY=""
