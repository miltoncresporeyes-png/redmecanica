{
  "name": "redmecanica-backend",
  "version": "1.0.0",
  "scripts": {
    "dev:api": "node api/dev.js",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "start:backend": "node dist/server.js",
    "start:ts": "tsx src/server.ts",
    "build": "npx prisma generate && tsc -p tsconfig.json --skipLibCheck",
    "postinstall": "npx prisma generate",
    "migrate": "npx prisma migrate dev",
    "seed": "tsx prisma/seed.ts",
    "reprocess:launch-leads": "tsx scripts/reprocess-launch-leads.ts",
    "reprocess:launch-confirmations": "tsx scripts/resend-launch-confirmations.ts",
    "prisma:generate": "npx prisma generate || true",
    "db:push": "npx prisma db push"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "axios": "^1.21.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "resend": "^6.37.0",
    "socket.io": "^4.8.4",
    "uuid": "^13.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@prisma/config": "^7.9.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.9.9",
    "@types/nodemailer": "^7.0.12",
    "@types/pg": "^8.23.1",
    "mysql2": "^3.24.6",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
